datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  SELLER
}

enum Platform {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
}

enum MessageSender {
  CUSTOMER
  SELLER
  BOT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationStatus {
  OPEN
  RESOLVED
  PENDING
}

enum BuildStatus {
  QUEUED
  GENERATING_PAGES
  UPLOADING_PRODUCTS
  APPLYING_THEME
  DEPLOYING
  DONE
  FAILED
}

enum StoreStatus {
  BUILDING
  LIVE
  PAUSED
}

enum NotificationType {
  ORDER_NEW
  ORDER_STATUS
  PAYMENT_RECEIVED
  STOCK_LOW
  CUSTOMER_NEW
  CONVERSATION_NEW
  SYSTEM
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id                      Int       @id @default(autoincrement())
  name                    String
  email                   String    @unique
  password                String?
  authProvider            String    @default("LOCAL")
  googleId                String?   @unique
  facebookId              String?   @unique
  role                    Role      @default(SELLER)
  emailVerified           Boolean   @default(false)
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?

  sellerId Int?
  seller   Seller? @relation(fields: [sellerId], references: [id])

  passwordResets  PasswordReset[]
  refreshSessions RefreshSession[]

  assignedConversations Conversation[] @relation("ConversationAssignee")

  createdAt DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ─────────────────────────────────────────────
// SELLER
// ─────────────────────────────────────────────

model Seller {
  id           Int     @id @default(autoincrement())
  businessName String
  gstNumber    String?
  phone        String?

  onboardedAt  DateTime?
  industry     String?
  businessSize String?

  paymentGateway   String?
  gatewayKeyId     String?
  gatewayKeySecret String?

  createdAt DateTime @default(now())

  users         User[]
  products      Product[]
  orders        Order[]
  uploads       Upload[]
  customers     Customer[]
  stores        Store[]
  conversations Conversation[]
  notifications Notification[]
  channels      ChannelConnection[]
  quickReplies  QuickReply[] // FIX: added missing back-relation
}

// ─────────────────────────────────────────────
// CHANNEL CONNECTIONS
// ─────────────────────────────────────────────

model ChannelConnection {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  platform Platform

  name String?

  accessToken  String?
  refreshToken String?

  externalAccountId String?

  // FIX: removed stray inline JSON literal that was placed after the field type
  metadata Json?

  webhookUrl    String?
  webhookSecret String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, platform])
  @@index([sellerId])
  @@index([platform])
}

// ─────────────────────────────────────────────
// CONVERSATION SYSTEM
// ─────────────────────────────────────────────

model Conversation {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  platform Platform
  status   ConversationStatus @default(OPEN)

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerPhone String?
  customerEmail String?

  externalUserId   String
  externalThreadId String?

  unreadCount Int @default(0)

  lastMessage   String?
  lastMessageAt DateTime?

  assignedToId Int?
  assignedTo   User? @relation("ConversationAssignee", fields: [assignedToId], references: [id])

  labelId Int?
  label   Label? @relation(fields: [labelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([sellerId, platform, externalUserId, externalThreadId])
  @@index([sellerId])
  @@index([platform])
  @@index([status])
  @@index([assignedToId])
  @@index([labelId])
}

// ─────────────────────────────────────────────
// LABEL
// ─────────────────────────────────────────────

model Label {
  id   Int    @id @default(autoincrement())
  name String @unique

  conversations Conversation[]
}

// ─────────────────────────────────────────────
// MESSAGES
// ─────────────────────────────────────────────

model Message {
  id Int @id @default(autoincrement())

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender    MessageSender
  direction MessageDirection
  status    MessageStatus    @default(SENT)

  text String @db.Text
  type String @default("text")

  mediaUrl String?

  externalMessageId String?
  metadata          Json?

  replyToMessageId Int?
  replyToMessage   Message?  @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies          Message[] @relation("MessageReplies")

  // FIX: these four fields were accidentally placed outside the model block
  isRead     Boolean @default(false)
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  // Prevent duplicate processing of the same provider message.
  // PostgreSQL permits multiple NULL values in a unique index.
  @@unique([conversationId, externalMessageId])
  @@index([conversationId])
  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────
// QUICK REPLY
// ─────────────────────────────────────────────

model QuickReply {
  id Int @id @default(autoincrement())

  sellerId Int
  // FIX: relation args were split with misplaced parentheses
  seller   Seller @relation(fields: [sellerId], references: [id])

  title   String
  content String @db.Text

  createdAt DateTime @default(now())

  @@index([sellerId])
}

// ─────────────────────────────────────────────
// WEBHOOK
// ─────────────────────────────────────────────

model WebhookEvent {
  id Int @id @default(autoincrement())

  platform Platform

  sellerId Int?

  eventType String

  payload Json

  processed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([platform])
  @@index([processed])
}

// ─────────────────────────────────────────────
// COMMERCE
// ─────────────────────────────────────────────

model Customer {
  id       Int    @id @default(autoincrement())
  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  name  String
  email String?
  phone String?

  totalOrders Int   @default(0)
  totalSpent  Float @default(0)

  lastOrderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders        Order[]
  conversations Conversation[]

  @@unique([sellerId, email])
}

model Order {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerPhone String?
  customerEmail String?

  shippingAddress String?

  subtotal    Float? @default(0)
  tax         Float? @default(0)
  totalAmount Float

  status        String  @default("PENDING")
  paymentStatus String  @default("UNPAID")
  paymentMethod String?

  trackingNumber String?
  timeline       Json?

  createdAt DateTime @default(now())

  products ProductOrder[]

  @@index([sellerId])
  @@index([customerId])
  @@index([status])
}

model Product {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  name        String
  description String?
  category    String?

  price Float
  mrp   Float?

  stock Int      @default(0)
  sizes String[]

  imageUrl String?

  createdAt DateTime @default(now())

  productOrders ProductOrder[]

  @@index([sellerId])
}

model ProductOrder {
  id Int @id @default(autoincrement())

  productId Int
  orderId   Int

  quantity        Int
  priceAtPurchase Float?

  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
}

model Upload {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  filename String
  url      String

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String

  isRead Boolean @default(false)

  link String?
  meta Json?

  priority String?

  createdAt DateTime @default(now())

  @@index([sellerId])
  @@index([sellerId, isRead])
  @@index([sellerId, createdAt])
}

// ─────────────────────────────────────────────
// STORE BUILDER
// ─────────────────────────────────────────────

model Theme {
  id String @id

  name        String
  category    String
  previewBg   String
  accentColor String
  layout      String

  tags   String[]
  active Boolean  @default(true)

  stores Store[]
}

model Store {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id])

  storeName String
  slug      String @unique

  logoUrl      String?
  customDomain String? @unique

  status StoreStatus @default(BUILDING)

  homepageHtml String? @db.Text
  aboutHtml    String? @db.Text

  metaTitle String?
  metaDesc  String?

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildJobs BuildJob[]

  @@index([sellerId])
}

model BuildJob {
  id Int @id @default(autoincrement())

  storeId  Int
  sellerId Int

  store Store @relation(fields: [storeId], references: [id])

  status      BuildStatus @default(QUEUED)
  currentStep String?
  errorMsg    String?

  themeId   String
  storeName String
  logoUrl   String?

  catalogJson Json?

  deployedUrl String?
  buildLog    Json?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([sellerId])
  @@index([status])
}

// ─────────────────────────────────────────────
// CONTACT SUBMISSIONS
// ─────────────────────────────────────────────

model ContactSubmission {
  id Int @id @default(autoincrement())

  name    String
  email   String
  phone   String?
  company String?
  subject String?
  message String

  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}
