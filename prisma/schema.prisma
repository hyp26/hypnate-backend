datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  SELLER
}

enum Platform {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
}

enum MessageSender {
  CUSTOMER
  SELLER
  BOT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationStatus {
  OPEN
  RESOLVED
  PENDING
}

enum BuildStatus {
  QUEUED
  GENERATING_PAGES
  UPLOADING_PRODUCTS
  APPLYING_THEME
  DEPLOYING
  DONE
  FAILED
}

enum StoreStatus {
  BUILDING
  LIVE
  PAUSED
}

enum NotificationType {
  ORDER_NEW
  ORDER_STATUS
  PAYMENT_RECEIVED
  STOCK_LOW
  CUSTOMER_NEW
  CONVERSATION_NEW
  SYSTEM
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id                      Int       @id @default(autoincrement())
  name                    String
  email                   String    @unique
  password                String?
  authProvider            String    @default("LOCAL")
  googleId                String?   @unique
  facebookId              String?   @unique
  role                    Role      @default(SELLER)
  emailVerified           Boolean   @default(false)
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?

  sellerId Int?
  seller   Seller? @relation(fields: [sellerId], references: [id])

  passwordResets  PasswordReset[]
  refreshSessions RefreshSession[]

  assignedConversations Conversation[] @relation("ConversationAssignee")

  createdAt DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ─────────────────────────────────────────────
// SELLER
// ─────────────────────────────────────────────

model Seller {
  id           Int     @id @default(autoincrement())
  businessName String
  gstNumber    String?
  phone        String?

  // Platform-level status managed from the admin panel.
  status String @default("ACTIVE")

  onboardedAt  DateTime?
  industry     String?
  businessSize String?
  // Plan selected during signup/onboarding. This alone does not grant access.
  selectedPlan String?

  // 7-day product trial. No payment method is collected during the trial.
  trialPlan      String?
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  trialUsedAt    DateTime?

  // Paid subscription entitlement. Set only after verified Razorpay payment/webhook.
  activePlan             String?
  planStatus             String?
  planActivatedAt        DateTime?
  planCurrentPeriodEnd   DateTime?
  razorpaySubscriptionId String?   @unique
  razorpayPlanId         String?
  billingCycle           String?

  paymentGateway   String?
  gatewayKeyId     String?
  gatewayKeySecret String?

  createdAt DateTime @default(now())

  users         User[]
  products      Product[]
  orders        Order[]
  uploads       Upload[]
  customers     Customer[]
  stores        Store[]
  conversations Conversation[]
  notifications Notification[]
  channels      ChannelConnection[]
  quickReplies  QuickReply[] // FIX: added missing back-relation
}

// ─────────────────────────────────────────────
// CHANNEL CONNECTIONS
// ─────────────────────────────────────────────

model ChannelConnection {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  platform Platform

  name String?

  accessToken  String?
  refreshToken String?

  externalAccountId String?

  // FIX: removed stray inline JSON literal that was placed after the field type
  metadata Json?

  webhookUrl    String?
  webhookSecret String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, platform])
  @@index([sellerId])
  @@index([platform])
}

// ─────────────────────────────────────────────
// CONVERSATION SYSTEM
// ─────────────────────────────────────────────

model Conversation {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  platform Platform
  status   ConversationStatus @default(OPEN)

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerPhone String?
  customerEmail String?

  externalUserId   String
  externalThreadId String?

  unreadCount Int @default(0)

  lastMessage   String?
  lastMessageAt DateTime?

  assignedToId Int?
  assignedTo   User? @relation("ConversationAssignee", fields: [assignedToId], references: [id])

  labelId Int?
  label   Label? @relation(fields: [labelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([sellerId, platform, externalUserId, externalThreadId])
  @@index([sellerId])
  @@index([platform])
  @@index([status])
  @@index([assignedToId])
  @@index([labelId])
}

// ─────────────────────────────────────────────
// LABEL
// ─────────────────────────────────────────────

model Label {
  id   Int    @id @default(autoincrement())
  name String @unique

  conversations Conversation[]
}

// ─────────────────────────────────────────────
// MESSAGES
// ─────────────────────────────────────────────

model Message {
  id Int @id @default(autoincrement())

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender    MessageSender
  direction MessageDirection
  status    MessageStatus    @default(SENT)

  text String @db.Text
  type String @default("text")

  mediaUrl String?

  externalMessageId String?
  metadata          Json?

  replyToMessageId Int?
  replyToMessage   Message?  @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies          Message[] @relation("MessageReplies")

  // FIX: these four fields were accidentally placed outside the model block
  isRead     Boolean @default(false)
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  // Prevent duplicate processing of the same provider message.
  // PostgreSQL permits multiple NULL values in a unique index.
  @@unique([conversationId, externalMessageId])
  @@index([conversationId])
  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────
// QUICK REPLY
// ─────────────────────────────────────────────

model QuickReply {
  id Int @id @default(autoincrement())

  sellerId Int
  // FIX: relation args were split with misplaced parentheses
  seller   Seller @relation(fields: [sellerId], references: [id])

  title   String
  content String @db.Text

  createdAt DateTime @default(now())

  @@index([sellerId])
}

// ─────────────────────────────────────────────
// WEBHOOK
// ─────────────────────────────────────────────

model WebhookEvent {
  id Int @id @default(autoincrement())

  platform Platform

  sellerId Int?

  eventType String

  payload Json

  processed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([platform])
  @@index([processed])
}

// ─────────────────────────────────────────────
// COMMERCE
// ─────────────────────────────────────────────

model Customer {
  id       Int    @id @default(autoincrement())
  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  name  String
  email String?
  phone String?

  totalOrders Int   @default(0)
  totalSpent  Float @default(0)

  lastOrderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders        Order[]
  conversations Conversation[]

  @@unique([sellerId, email])
}

model Order {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerPhone String?
  customerEmail String?

  shippingAddress String?

  subtotal    Float? @default(0)
  tax         Float? @default(0)
  totalAmount Float

  status        String  @default("PENDING")
  paymentStatus String  @default("UNPAID")
  paymentMethod String?

  trackingNumber String?
  timeline       Json?

  createdAt DateTime @default(now())

  products ProductOrder[]

  @@index([sellerId])
  @@index([customerId])
  @@index([status])
}

model Product {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  name        String
  description String?
  category    String?

  price Float
  mrp   Float?

  stock Int      @default(0)
  sizes String[]

  imageUrl String?

  createdAt DateTime @default(now())

  productOrders ProductOrder[]

  @@index([sellerId])
}

model ProductOrder {
  id Int @id @default(autoincrement())

  productId Int
  orderId   Int

  quantity        Int
  priceAtPurchase Float?

  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
}

model Upload {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  filename String
  url      String

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String

  isRead Boolean @default(false)

  link String?
  meta Json?

  priority String?

  createdAt DateTime @default(now())

  @@index([sellerId])
  @@index([sellerId, isRead])
  @@index([sellerId, createdAt])
}

// ─────────────────────────────────────────────
// STORE BUILDER
// ─────────────────────────────────────────────

model Theme {
  id String @id

  name        String
  category    String
  previewBg   String
  accentColor String
  layout      String

  tags   String[]
  active Boolean  @default(true)

  stores Store[]
}

model Store {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id])

  storeName String
  slug      String @unique

  logoUrl      String?
  customDomain String? @unique

  status StoreStatus @default(BUILDING)

  homepageHtml String? @db.Text
  aboutHtml    String? @db.Text

  metaTitle String?
  metaDesc  String?

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildJobs BuildJob[]

  @@index([sellerId])
}

model BuildJob {
  id Int @id @default(autoincrement())

  storeId  Int
  sellerId Int

  store Store @relation(fields: [storeId], references: [id])

  status      BuildStatus @default(QUEUED)
  currentStep String?
  errorMsg    String?

  themeId   String
  storeName String
  logoUrl   String?

  catalogJson Json?

  deployedUrl String?
  buildLog    Json?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([sellerId])
  @@index([status])
}

// ─────────────────────────────────────────────
// CONTACT SUBMISSIONS
// ─────────────────────────────────────────────

model ContactSubmission {
  id Int @id @default(autoincrement())

  name    String
  email   String
  phone   String?
  company String?
  subject String?
  message String

  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// PRIVACY / META DATA DELETION
// ─────────────────────────────────────────────

enum DeletionRequestStatus {
  PENDING
  VERIFIED
  PROCESSING
  COMPLETED
  REJECTED
}

// Intake record for public data-deletion requests.
// Meta platform compliance. A record is created as
// PENDING and is only progressed after Hypnate verifies
// the requester out-of-band. This model intentionally
// stores no account references.

model DeletionRequest {
  id Int @id @default(autoincrement())

  contactEmail String
  details      String?

  status     DeletionRequestStatus @default(PENDING)
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([contactEmail])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ADMIN PANEL
// ─────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum AdminAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TicketStatus {
  OPEN
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnnouncementType {
  GENERAL
  MAINTENANCE
  FEATURE
  SECURITY
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SETTINGS
}

// Platform staff accounts. Completely separate from the
// seller-facing User table: admin logins never mix with
// seller/shop accounts.
model AdminUser {
  id           Int                @id @default(autoincrement())
  email        String             @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdminRole          @default(SUPPORT)
  status       AdminAccountStatus @default(ACTIVE)
  avatarUrl    String?
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        AdminSession[]
  auditLogs       AuditLog[]
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  ticketMessages  TicketMessage[] @relation("TicketMessageAuthor")
}

// Persisted admin refresh sessions. Only the SHA-256 hash
// of the raw refresh token is stored, mirroring RefreshSession.
model AdminSession {
  id          Int       @id @default(autoincrement())
  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// Support tickets handled from the admin panel.
// sellerId / customerId are soft references kept as plain
// integers so tickets survive seller-side data cleanup.
model SupportTicket {
  id           Int            @id @default(autoincrement())
  ticketNumber String         @unique
  subject      String
  description  String?        @db.Text
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  category     String?

  sellerId   Int?
  customerId Int?

  assignedToAdminId Int?
  assignedTo        AdminUser? @relation("TicketAssignee", fields: [assignedToAdminId], references: [id])

  tags     String[]
  messages TicketMessage[]

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([priority])
  @@index([assignedToAdminId])
  @@index([createdAt])
}

model TicketMessage {
  id       Int           @id @default(autoincrement())
  ticketId Int
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorAdminId Int?
  authorAdmin   AdminUser? @relation("TicketMessageAuthor", fields: [authorAdminId], references: [id])

  body String @db.Text

  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Announcement {
  id      Int    @id @default(autoincrement())
  title   String
  content String @db.Text

  type   AnnouncementType   @default(GENERAL)
  status AnnouncementStatus @default(DRAFT)

  priority       TicketPriority @default(MEDIUM)
  targetAudience String         @default("ALL")

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
}

model FAQItem {
  id       Int    @id @default(autoincrement())
  question String
  answer   String @db.Text

  category String   @default("General")
  tags     String[]
  order    Int      @default(0)

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([order])
}

// Editable static pages surfaced through the admin
// Content screen (about, terms, privacy, etc.).
model ContentPage {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  title String
  body  String @db.Text

  status ContentStatus @default(DRAFT)

  createdByAdminId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Immutable trail of every privileged admin action.
model AuditLog {
  id          Int        @id @default(autoincrement())
  adminUserId Int?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  action     AuditAction
  entityType String?
  entityId   String?

  oldValue Json?
  newValue Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// Key/value store for admin panel settings and feature flags.
model AdminSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value Json

  updatedAt DateTime @updatedAt
}
