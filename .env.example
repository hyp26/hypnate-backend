# ----------------------------
# Server
# ----------------------------
NODE_ENV=development
PORT=4000

# ----------------------------
# Database
# ----------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hypnate_db"

# ----------------------------
# Authentication
# ----------------------------
JWT_SECRET="replace-with-at-least-32-random-characters"
REFRESH_SECRET="replace-with-at-least-32-random-characters"
ENCRYPTION_KEY="replace-with-a-strong-secret-key"
TOKEN_EXPIRY="7d"
SALT_ROUNDS=10

# ----------------------------
# Frontend
# ----------------------------
FRONTEND_URL="https://hypnate.in"

# ----------------------------
# Email / Contact
# ----------------------------
RESEND_API_KEY="re_..."
CONTACT_NOTIFICATION_EMAIL="info@hypnate.in"
CONTACT_FROM_EMAIL="Hypnate <noreply@hypnate.in>"

# ----------------------------
# WhatsApp / Meta
# ----------------------------
META_APP_ID="..."
META_APP_SECRET="..."
# OAuth callback lives on the backend API origin, not the frontend.
META_REDIRECT_URI="https://api.hypnate.in/api/channels/whatsapp/callback"
WHATSAPP_VERIFY_TOKEN="replace-with-a-long-random-token"
WEBHOOK_BASE_URL="https://api.hypnate.in"
META_GRAPH_VERSION="v25.0"

# ----------------------------
# Internal Hypnate-X API
# ----------------------------
INTERNAL_API_KEY="replace-with-at-least-32-random-characters"

# ----------------------------
# Cloudinary
# ----------------------------
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# ----------------------------
# Optional services
# ----------------------------
PYTHON_WORKER_URL=""
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
REDIS_URL=""

UPLOADS_DIR="./uploads"
MAX_FILE_SIZE=5242880
MAX_CATALOG_FILE_SIZE=15728640

// Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

RAZORPAY_PLAN_STARTER_MONTHLY=plan_xxxxxxxxx
RAZORPAY_PLAN_PRO_MONTHLY=plan_xxxxxxxxx
RAZORPAY_PLAN_BUSINESS_MONTHLY=plan_xxxxxxxxx

RAZORPAY_PLAN_STARTER_YEARLY=plan_xxxxxxxxx
RAZORPAY_PLAN_PRO_YEARLY=plan_xxxxxxxxx
RAZORPAY_PLAN_BUSINESS_YEARLY=plan_xxxxxxxxx
